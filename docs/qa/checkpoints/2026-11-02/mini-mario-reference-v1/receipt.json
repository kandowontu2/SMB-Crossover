  "source_navigation": {
    "plugins/PlatformerPlus/engine/src/states/platform.c": [
      {
        "line": 41,
        "text": "WORD plat_walk_vel;"
      },
      {
        "line": 42,
        "text": "WORD plat_run_vel;"
      },
      {
        "line": 47,
        "text": "WORD plat_jump_vel;"
      },
      {
        "line": 82,
        "text": "//WALL variables"
      },
      {
        "line": 83,
        "text": "BYTE last_wall;             //tracks the last wall the player touched"
      },
      {
        "line": 170,
        "text": "while (32000 - (plat_jump_vel/MIN(15,plat_hold_jump_max)) - plat_jump_min < 0){"
      },
      {
        "line": 177,
        "text": "while((32000/plat_run_boost) < ((plat_run_vel>>8)/plat_hold_jump_max)){"
      },
      {
        "line": 183,
        "text": "jump_per_frame = plat_jump_vel / MIN(15, plat_hold_jump_max);   //jump force applied per frame in the JUMP_STATE"
      },
      {
        "line": 513,
        "text": "//Gravity while holding jump"
      },
      {
        "line": 517,
        "text": "//Normal gravity"
      },
      {
        "line": 538,
        "text": "pl_vel_x = CLAMP(pl_vel_x + plat_run_acc, plat_min_vel, plat_run_vel);"
      },
      {
        "line": 550,
        "text": "pl_vel_x = CLAMP(pl_vel_x, plat_min_vel, plat_walk_vel);"
      },
      {
        "line": 624,
        "text": "last_wall = 1;"
      },
      {
        "line": 648,
        "text": "last_wall = -1;"
      },
      {
        "line": 839,
        "text": "// XX Checked in Fall, Wall, Ground, and basic_y_col, set in basic_y_col"
      },
      {
        "line": 879,
        "text": "//Water gravity"
      },
      {
        "line": 908,
        "text": "//If we're on a platform, zero out any other motion from gravity or other sources"
      },
      {
        "line": 934,
        "text": "if (pl_vel_x > (plat_run_vel >> 1)){"
      },
      {
        "line": 937,
        "text": "pl_vel_x = CLAMP(pl_vel_x + plat_run_acc, plat_min_vel >> 1, plat_run_vel >> 1);"
      },
      {
        "line": 1011,
        "text": "last_wall = 1;"
      },
      {
        "line": 1045,
        "text": "last_wall = -1;"
      },
      {
        "line": 1229,
        "text": "// XX Checked in Fall, Wall, Ground, and basic_y_col, set in basic_y_col"
      }
    ],
    "plugins/PlatformerPlus/engine/src/states/playerstates.c": [
      {
        "line": 107,
        "text": "//If we're on a platform, zero out any other motion from gravity or other sources"
      },
      {
        "line": 122,
        "text": "//Normal gravity"
      },
      {
        "line": 145,
        "text": "pl_vel_x = MIN(pl_vel_x + plat_run_acc, plat_run_vel);"
      },
      {
        "line": 159,
        "text": "pl_vel_x = CLAMP(pl_vel_x, plat_min_vel, plat_walk_vel);"
      },
      {
        "line": 224,
        "text": "last_wall = 1;"
      },
      {
        "line": 249,
        "text": "last_wall = -1;"
      },
      {
        "line": 273,
        "text": "UBYTE tile_start = (((PLAYER.pos.x >> 4) + PLAYER.bounds.left - ((pl_vel_x > plat_walk_vel)?3:0))  >> 3); //extend check by 3 pixels if running to be able to run over 1 tile gaps"
      },
      {
        "line": 274,
        "text": "UBYTE tile_end   = (((PLAYER.pos.x >> 4) + PLAYER.bounds.right + ((pl_vel_x < -plat_walk_vel)?3:0)) >> 3) + 1;"
      },
      {
        "line": 451,
        "text": "// XX Checked in Fall, Wall, Ground, and basic_y_col, set in basic_y_col"
      },
      {
