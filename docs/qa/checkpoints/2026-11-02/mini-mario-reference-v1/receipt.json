      },
      {
        "line": 631,
        "text": "last_wall = -1;"
      },
      {
        "line": 819,
        "text": "// XX Checked in Fall, Wall, Ground, and basic_y_col, set in basic_y_col"
      },
      {
        "line": 898,
        "text": "if (plat_jump_vel >= jump_reduction_val){"
      },
      {
        "line": 918,
        "text": "//After the jump frames end, use the reduced gravity"
      },
      {
        "line": 944,
        "text": "pl_vel_x = CLAMP(pl_vel_x + plat_run_acc, plat_min_vel, plat_run_vel);"
