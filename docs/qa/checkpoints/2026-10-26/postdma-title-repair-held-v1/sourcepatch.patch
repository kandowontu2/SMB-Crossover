     PRGLow: start = $8000,  size = $2000, type = ro, file = %O, fill = yes, fillval = $ff, bank = $7e;
     
-    ALIGN:  start = $e000,  size = $60,   type = ro, file = %O, fill = yes, bank = $7f;
-    PRGFix: start = $e060,  size = $2000 - $60, type = ro, file = %O, fill = yes, fillval = $ff, bank = $7f;
+    ALIGN:  start = $e000,  size = $66,   type = ro, file = %O, fill = yes, bank = $7f;
