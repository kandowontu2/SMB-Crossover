+ cmp #15
+ beq IsMac
+ lda SafecallA_SMC+1
+ plp
+ farcall Other,jmp
+IsMac:
+ plp
+ jmp Mac
+ .res 1,$ea
+ .assert *-Name=43,error,"Original side-gate span"
+.endproc
