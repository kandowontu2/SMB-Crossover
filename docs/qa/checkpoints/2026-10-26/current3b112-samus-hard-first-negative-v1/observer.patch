+local function samusBodyArt(ptr,cb)
+ local f=drawContext and drawContext.filtered
+ if f then
+  assert(cb==f.bank and ptr==f.pointer,'Filtered body retains its witnessed return pointer and C-bank')
+  local d=ptr-L.OutlinePoseBuffer
+  assert(d==0 or d==32 or d==64 or d==96,'Only actual source outline-buffer slots are admitted')
+  return{address=ptr,bank=cb,bytes=f.bytes},true
+ end
+ local expected=C.body_records[tostring(cb)..':'..tostring(ptr)]
+ assert(expected,'Actual selected body pointer is a bound Samus record')
+ return expected,false
+end
