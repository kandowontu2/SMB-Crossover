+hook('PlayerRemoveOutlines',function()
+ if not entered or not drawContext or drawContext.kind~='body'then return end
+ local ctx=drawContext;local cb=bank(0xc000);local ptr=r('R0')+256*r('R1')
+ local original=C.body_records[tostring(cb)..':'..tostring(ptr)]
+ assert(original,'Outline input is an immutable bound Samus body record')
+ for i,v in ipairs(original.bytes)do assert(emu.read(cb*8192+ptr%8192+i-1,emu.memType.nesPrgRom)==v,'Exact immutable pre-filter Samus source bytes')end
+ local filtered={0}
+ for i=2,#original.bytes,4 do
+  if original.bytes[i+1]&4==0 then for j=0,3 do filtered[#filtered+1]=original.bytes[i+j]end end
+ end
+ filtered[1]=#filtered-1
+ onReturn('Samus-source-outline-filter',function()
+  assert(drawContext==ctx and bank(0xc000)==cb,'Actual outline return retains body scope and C-bank')
+  local output=r('R0')+256*r('R1')
+  if output==ptr then
+   assert(original.bytes[1]==0 or original.bytes[1]>=129 or original.bytes[1]%4~=0,'Only original invalid-filter admission may retain ROM pointer')
+   return
+  end
+  assert(original.bytes[1]>0 and original.bytes[1]<129 and original.bytes[1]%4==0,'Source outline-filter header admission')
+  ctx.filtered={pointer=output,bank=cb,source_pointer=ptr,bytes=filtered}
+  local expected,isRAM=samusBodyArt(output,cb);assert(isRAM)
+  for i,v in ipairs(expected.bytes)do assert(emu.read(output+i-1,emu.memType.nesDebug)==v,'Exact legal filtered Samus RAM record bytes/header')end
+ end)
+end)
