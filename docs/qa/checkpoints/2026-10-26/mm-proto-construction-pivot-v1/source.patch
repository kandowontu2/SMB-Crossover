+    iny
+    iny
+    iny
+    iny
+  .endif
+.endrepeat
+  ldx #6
+  sec                        ; Exact final CPX6 C; LDY R0 restores native NZ.
+  ldy R0                     ;return offset set earlier
+  rts
+
+VineYPosAdder:
+  .byte $00, $30
+
+.endproc
