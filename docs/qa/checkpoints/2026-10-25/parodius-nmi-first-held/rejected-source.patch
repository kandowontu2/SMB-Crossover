--- a/src/nmi_vram_fast.s
+++ b/src/nmi_vram_fast.s
@@ -0,0 +1,52 @@
+; NMI-only: bank116 is already owned by SamusFreezeUpdateScreen.
+; Retain the native packet/data order, pointer/Y wrap, registers and flags.
+; No new RAM, foreground scratch, SMC, JSR or stack frame.
+.pushseg
+.segment "NMI_VRAM_FAST"
+.proc FastNmiVramCopy
+ bcs Repeat
+ ; X=0 has the native meaning256, not an empty packet.
+ cpx #0
+ beq Chunk
+ cpx #8
+ bcc Tail
+Chunk:
+ .repeat 8
+  iny
+  lda (NmiR0),y
+  sta PPUDATA
+  dex
+ .endrepeat
+ cpx #8
+ bcs Chunk
+Tail:
+ cpx #0
+ beq LiteralDone
+LiteralTail:
+ iny
+ lda (NmiR0),y
+ sta PPUDATA
+ dex
+ bne LiteralTail
+LiteralDone:
+ clc
+ jmp OutputToVRAM+11 ; native SEC and pointer/next-command continuation
+Repeat:
+ lda (NmiR0),y
+RepeatLoop:
+ sta PPUDATA
+ dex
+ bne RepeatLoop
+ sec
+ jmp OutputToVRAM+11
+.endproc
+.proc FastNmiPaletteCapture
+ .repeat 32,I
+  lda PPUDATA
+  sta PnBombPaletteShadow+I
+ .endrepeat
+ ldx #32
+ cpx #32
+ jmp PnPaletteScreenUpdate::Copy+11 ; after the unchanged old BNE
+.endproc
+.popseg
