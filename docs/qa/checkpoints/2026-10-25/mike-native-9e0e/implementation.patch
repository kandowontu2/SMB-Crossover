+StNativeSourceInit=StNativeP0E13
+StNativeSourcePlay=StNativeP06A4
+
+; Only the first ExpandedAudioTick family call reaches this path. Discard its
+; one inner return; the native updater returns to ExpandedAudioDecoded.
+StNativeFromFamily:
+  pla
+  pla
+  jmp StNativeMusicUpdate
+.proc StNativeMusicUpdate
+  lda #0
+  sta RgAudioRequest
+  lda OperMode
+  jeq Mute
+  lda XgAudioCharacter
+  cmp #$fb
+  beq Initialized
+  lda #$fb
+  sta XgAudioCharacter
+  lda #0
+  sta RgAudioSong
+  sta RgAudioSilenced
+  sta XgAudioEvent
+  lda #1
+  sta StNativePending
+Initialized:
+  lda AreaMusicQueue
+  ora EventMusicQueue
+  and #Silence
+  beq Area
+  lda #1
+  sta RgAudioSilenced
+Area:
+  lda AreaMusicQueue
+  and #$7f
+  beq Event
+  ldx #0
+FindArea:
+  lsr
+  bcs AreaFound
+  inx
+  bne FindArea
+AreaFound:
+  lda Areas,x
+  sta StNativePending
+  lda #0
+  sta RgAudioSilenced
+  sta XgAudioEvent
+Event:
+  lda EventMusicQueue
+  and #$7f
+  beq Pause
+  ldx #0
+FindEvent:
+  lsr
+  bcs EventFound
+  inx
+  bne FindEvent
+EventFound:
+  lda Events,x
+  sta StNativePending
+  lda #0
+  sta RgAudioSilenced
+  lda #1
+  sta XgAudioEvent
+  cpx #6
+  bne Pause
+  lda #4
+  sta XgAudioEvent
+Pause:
+  lda GamePauseStatus
+  and #1
+  jne Mute
+  lda RgAudioSilenced
+  jne Mute
+  lda StNativePending
+  sta RgAudioRequest
+  bne Restart
+  lda XgAudioEvent
+  cmp #2
+  jeq Mute
+  ; All six source channel states are $ff at a finite tune's end. A queued
+  ; original init still has its source request in $a0 until first play.
+  lda StNativeZp
+  bne SaveCpu
+  lda StNativeRam+$10
+  and StNativeRam+$11
+  and StNativeRam+$12
+  and StNativeRam+$13
+  and StNativeRam+$14
+  and StNativeRam+$15
+  cmp #$ff
+  bne SaveCpu
+  lda XgAudioEvent
+  beq LoopWholeTune
+  cmp #4
+  beq LoopWholeTune
+  lda #2
+  sta XgAudioEvent
+  jmp Mute
+LoopWholeTune:
+  lda RgAudioSong
+  sta RgAudioRequest
+Restart:
+  lda RgAudioRequest
+  sta RgAudioSong
+  inc XgAudioSong
+  lda #0
+  ldx #$9f
+ResetState:
+  sta StNativeRam,x
+  dex
+  cpx #$ff
+  bne ResetState
+  ldx #15
+ResetImage:
+  sta StNativeZp,x
+  sta GuestNativeApu,x
+  lda #1
+  sta GuestNativeDirty,x
+  lda #0
+  dex
+  bpl ResetImage
+SaveCpu:
+  jsr StNativeBorrow
+  lda RgAudioRequest
+  beq Play
+  sec
+  sbc #1
+  ldx #0
+  ldy #0
+  jsr StNativeSourceInit
+  lda #0
+  sta StNativePending
+  jmp Restore
+Play:
+  lda StNativeRam
+  cmp GuestNativeEnable
+  beq Enabled
+  jsr GuestNativeStatusSTA
+Enabled:
+  ldx #0
+  ldy #0
+  jsr StNativeMusicPlay
+Restore:
+  jsr StNativeRestore
+  jmp Queues
+Mute:
+  lda #0
+  jsr GuestNativeStatusSTA
+Queues:
+  lda #0
+  sta AreaMusicQueue
+  sta EventMusicQueue
+  sta Square1SoundQueue
+  sta Square2SoundQueue
+  sta NoiseSoundQueue
+  rts
+Areas:
+  .byte 1,2,4,5,14,11,22
+Events:
+  .byte 13,15,9,17,15,9,5
+.endproc
+; The adapter never feeds original NSF SFX queues. Init is the only selected
+; music writer to A2..A5/7168, and clears them with X=0. Keep pending-init's
+; full original dispatch; active music enters its unmodified channel loop.
+StNativeMusicPlay:
+  lda StNativeZp
+  bmi StNativeFullSource
+  beq StNativeMusicIdle
+  jmp StNativeP06CE
+StNativeMusicIdle:
+  rts
+StNativeFullSource:
+  jmp StNativeSourcePlay
+StNativeStatusSTX:
+  php
+  pha
+  txa
+  jsr GuestNativeStatusSTA
+  pla
+  plp
+  rts
+
+StNativeBorrow:
+  lda $ac
+  sta StNativeSavedZp+0
+  lda StNativeZp+6
+  sta $ac
+  lda $ad
+  sta StNativeSavedZp+1
+  lda StNativeZp+7
+  sta $ad
+  lda $f0
+  sta StNativeSavedZp+2
+  lda StNativeZp+8
+  sta $f0
+  lda $f1
+  sta StNativeSavedZp+3
+  lda StNativeZp+9
+  sta $f1
+  rts
+StNativeRestore:
+  lda $ac
+  sta StNativeZp+6
+  lda StNativeSavedZp+0
+  sta $ac
+  lda $ad
+  sta StNativeZp+7
+  lda StNativeSavedZp+1
+  sta $ad
+  lda $f0
+  sta StNativeZp+8
+  lda StNativeSavedZp+2
+  sta $f0
+  lda $f1
+  sta StNativeZp+9
+  lda StNativeSavedZp+3
+  sta $f1
+  rts
+StNativeEnd:
+.assert *-StNativeBankStart <= $1e00,error,"Mike source exceeds unused bank-115 tail"
+.popseg
