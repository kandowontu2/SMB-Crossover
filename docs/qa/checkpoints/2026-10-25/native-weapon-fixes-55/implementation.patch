@@ -0,0 +1,9 @@
+; Source2.02 Ryu.pressAtkBtn rejects primary while Jump Slash remains live.
+.pushseg
+.segment "EXPANDED_EX"
+.proc RyuPrimaryBlocked
+  lda XgWall
+  ora AvSlash
+  rts
+.endproc
+.popseg
--- /dev/null
+++ b/src/sophia_missile_capacity.s
@@ -0,0 +1,21 @@
+; Reserve all three shared projectile slots before spending one missile volley.
+; Existing missile-type occupancy retains the native one-volley limit.
+.pushseg
+.segment "SPECIAL_EXTRA"
+.proc SophiaTripletAdmission
+ ldx #9
+ ldy #3
+Loop:
+ lda RgShotType,x
+ bne Next
+ dey
+ beq Enough
+Next:
+ dex
+ bpl Loop
+ sty AvCount
+ rts
+Enough:
+ jmp RemainingWeapons::CountType
+.endproc
+.popseg
--- /dev/null
+++ b/src/smb3_projectile_damage.s
@@ -0,0 +1,30 @@
+; SMB3 projectiles retain source weapon admission/lifetime against SMB foes.
+; Bowser damage uses the host's existing HP and native defeat progression.
+.pushseg
+.segment "M3_LOGIC"
+.proc M3ProjectileAdmission
+ lda Enemy_ID,y
+ cmp #Bowser
+ beq Allowed
+ cmp #BuzzyBeetle
+ bne Ordinary
+ ldx M3SavedSlot
+ lda M3ShotKind,x
+ cmp #2
+ bne BeetleFire
+ lda #0 ; Only the following temporary ID filters see this value.
+Allowed:clc
+ rts
+BeetleFire:lda #BuzzyBeetle
+Ordinary:cmp #$15
+ rts
+.endproc
+.proc M3ProjectileDamage
+ lda Enemy_ID,x
+ cmp #Bowser
+ beq Boss
+ jmp M3DefeatEnemy
+Boss:stx R1
+ jmp HandleEnemyFBallCol
+.endproc
+.popseg
