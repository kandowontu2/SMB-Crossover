+.endproc
+.proc CheatsShipPower
+ ; Let the real owners initialize first; fullpower must not be overwritten
+ ; by the first native movement tick. At most20 genuine purchases fit all
+ ; native caps, with no unbounded retry if a source purchase refuses.
+ farcall VvEnsure
+ lda VvVariant
+ beq Ready
+ farcall PnEnsure
+Ready:jsr Full
+ bcs Done
+ lda #20
+Buy:pha
+ jsr CheatsShipMax
+ pla
+ tax
+ dex
+ txa
+ bne Buy
+Done:rts
+Full:lda VvVariant
+ bne Pn
+ lda VvSpeed
+ cmp #14
+ bcc No
+ lda VvMissile
+ beq No
+ lda VvGun
+ beq No
+ lda VvOptions
+ cmp #2
+ bcc No
+ lda VvShield
+ cmp #5
+ rts
+Pn:lda VvSpeed
+ cmp #4
+ bcc No
+ lda VvGun
+ and #8
+ beq No
+ lda VvGun
+ and #$c0
+ beq No
+ lda VvGun
+ and #7
+ ldx VvVariant
+ cpx #2
+ bcc Four
+ cmp #3
+ rts
+Four:cmp #4
+ rts
+No:clc
+ rts
+.endproc
+.proc CheatsShipMax
+ lda VvVariant
+ jne Parodius
+ lda VvSpeed
+ cmp #14 ; native motion cap: (speed+2)/2, capped at8pixels.
+ bcs Missile
+ lda #1
+ jsr Buy
+ rts
+Missile:lda VvMissile
+ bne Gun
+ lda #2
+ jsr Buy
+ rts
+Gun:lda VvGun
+ bne Options
+ lda #4 ; native laser default; preserve a currentlyselectedDOUBLE.
+ jsr Buy
+ rts
+Options:lda VvOptions
+ cmp #2
+ bcs Shield
+ lda #5
+ jsr Buy
+ rts
+Shield:lda VvShield
+ cmp #5
+ bcs Done
+ ; The real purchase refuses a nonzero shield. A partlyused shield remains
+ ; sourcelegal and is refilled to its sourcemaximum by the cheat directly.
+ lda VvShield
+ beq NewShield
+ lda #5
+ sta VvShield
+ lda #1
+ sta VvHudDirty
+ rts
+NewShield:lda #6
+ jsr Buy
+Done:rts
+Buy:
+ pha
+ lda VvHeld
+ pha
+ lda VvMeter
+ pha
+ tsx
+ lda $0103,x
+ sta VvMeter
+ lda VvHeld
+ ora #B_Button
+ sta VvHeld
+ farcall VvBuyUpgrade
+ pla
+ sta VvMeter
+ pla
+ sta VvHeld
+ pla
+ rts
+Parodius:
+ ; Original bar bits1speed/2missile/4double/8laser/16options. Bit32 is
+ ; RESET, never a grant. Bellpowers are temporary choices, not stacked.
+ lda VvSpeed
+ cmp #4
+ bcs PnMissile
+ lda #1
+ jsr PnBuy
+ rts
+PnMissile:lda VvGun
+ and #8
+ bne PnBeam
+ lda #2
+ jsr PnBuy
+ rts
+PnBeam:lda VvGun
+ and #$c0
+ bne PnOptions
+ lda #8
+ jsr PnBuy
+ rts
+PnOptions:lda VvGun
+ and #7
+ ldx VvVariant
+ cpx #2
+ bcc Four
+ cmp #3
+ bcs Done
+ lda #16
+ jsr PnBuy
+ rts
+Four:cmp #4
+ bcs Done
+ lda #16
+ jsr PnBuy
+ rts
+PnBuy:
+ pha
+ lda VvMeter
+ pha
+ lda VvFresh
+ pha
+ lda PnAutoMode
+ pha
+ lda CurrentBankC
+ pha
+ BankPRGC #.bank(PnAnimationTable)
+ lda #0
+ sta PnAutoMode
+ lda #$80
+ sta VvFresh
+ tsx
+ lda $0105,x
+ sta VvMeter
+ farcall PnNativeGear
+ pla
+ BankPRGC a
+ pla
+ sta PnAutoMode
+ pla
+ sta VvFresh
+ pla
+ sta VvMeter
+ pla
+ lda #1
+ sta VvHudDirty
+ rts
+.endproc
