--- a/src/cheats_four.s
+++ b/src/cheats_four.s
@@ -0,0 +1,988 @@
+; Expanded MMC5 only. Decimal63/$3F cold page, not decimal99/$63 UI.
+; Persistent flags reuse CheatInvincible: bit0 injury,1 air jump,2 wrap,
+; 3 countdown hold,4 full power. No new WRAM/ExRAM allocation.
+.pushseg
+.segment "CHEATS_FOUR"
+CheatAir=$02
+CheatWrap=$04
+CheatTimer=$08
+CheatPower=$10
+.proc CheatsSixInput
+ lda CrossoverMenuPressed
+ and #B_Button
+ beq Navigate
+ lda #2
+ sta CrossoverOptionsFocus
+ lda #3
+ sta CrossoverMenuState
+ lda #1
+ sta DisableScreenFlag
+ rts
+Navigate:
+ lda CrossoverMenuPressed
+ and #Up_Dir|Down_Dir
+ beq Change
+ and #Up_Dir
+ beq Down
+ dec CrossoverOptionsFocus
+ bpl Changed
+ lda #5
+ bne Focus
+Down:inc CrossoverOptionsFocus
+ lda CrossoverOptionsFocus
+ cmp #6
+ bcc Changed
+ lda #0
+Focus:sta CrossoverOptionsFocus
+ jmp Changed
+Change:
+ lda CrossoverMenuPressed
+ and #A_Button|Start_Button|Select_Button|Left_Dir|Right_Dir
+ beq Done
+ ldx CrossoverOptionsFocus
+ cpx #1
+ beq Level
+ lda CheatInvincible
+ eor Bits,x
+ sta CheatInvincible
+ jmp Changed
+Level:
+ lda CrossoverMenuPressed
+ and #Left_Dir
+ beq Forward
+ dec CheatStartLevel
+ jmp Wrap
+Forward:inc CheatStartLevel
+Wrap:lda CheatStartLevel
+ and #31
+ ora #$20
+ sta CheatStartLevel
+Changed:
+ lda #Sfx_CoinGrab
+ sta Square2SoundQueue
+ jsr CheatsSixQueue
+Done:rts
+Bits:.byte $01,$00,$02,$04,$08,$10
+.endproc
+.proc CheatsSixQueue
+ ; Six3-cell values36B +4B vertical RLE cursor erase +4B cursor =44B.
+ ldy #0
+Row:
+ tya
+ pha
+ ldx VRAM_Buffer1_Offset
+ lda AddrHi,y
+ sta VRAM_Buffer1,x
+ lda AddrLo,y
+ clc
+ adc #17
+ sta VRAM_Buffer1+1,x
+ lda #3
+ sta VRAM_Buffer1+2,x
+ cpy #1
+ beq Level
+ lda CheatInvincible
+ and CheatsSixInput::Bits,y
+ beq Off
+ lda #$24
+ sta VRAM_Buffer1+5,x
+ lda #'O'
+ sta VRAM_Buffer1+3,x
+ lda #'N'
+ bne Middle
+Off:lda #'F'
+ sta VRAM_Buffer1+5,x
+ sta VRAM_Buffer1+4,x
+ lda #'O'
+ sta VRAM_Buffer1+3,x
+ jmp Next
+Level:
+ lda CheatStartLevel
+ and #31
+ lsr
+ lsr
+ clc
+ adc #1
+ sta VRAM_Buffer1+3,x
+ lda CheatStartLevel
+ and #3
+ clc
+ adc #1
+ sta VRAM_Buffer1+5,x
+ lda #'-'
+Middle:sta VRAM_Buffer1+4,x
+Next:txa
+ clc
+ adc #6
+ sta VRAM_Buffer1_Offset
+ pla
+ tay
+ iny
+ cpy #6
+ bcc Row
+ ldx VRAM_Buffer1_Offset
+ lda #$21
+ sta VRAM_Buffer1,x
+ lda #$23
+ sta VRAM_Buffer1+1,x
+ lda #$cb
+ sta VRAM_Buffer1+2,x
+ lda #$24
+ sta VRAM_Buffer1+3,x
+ lda #0
+ sta VRAM_Buffer1+4,x
+ inx
+ inx
+ inx
+ inx
+ ldy CrossoverOptionsFocus
+ lda AddrHi,y
+ sta VRAM_Buffer1,x
+ lda AddrLo,y
+ sec
+ sbc #2
+ sta VRAM_Buffer1+1,x
+ lda #1
+ sta VRAM_Buffer1+2,x
+ lda #$3f
+ sta VRAM_Buffer1+3,x
+ lda #0
+ sta VRAM_Buffer1+4,x
+ txa
+ clc
+ adc #4
+ sta VRAM_Buffer1_Offset
+ rts
+AddrHi:.byte $21,$21,$21,$21,$22,$22
+AddrLo:.byte $25,$65,$a5,$e5,$25,$65
+.endproc
+.proc CheatsSixPage
+ php
+ sei ; serialize direct PPU address/data pairs against visible-split IRQ
+ ; BuildOptions owns forced blank. Clearrows8..26, including parent
+ ; AUDIO TEST row22/footer; paint this page's own B-back atrow23.
+ bit PPUSTATUS
+ lda #$20
+ sta PPUADDR
+ lda #$cb
+ sta PPUADDR
+ ldx #0
+Header:lda Title,x
+ sta PPUDATA
+ inx
+ cpx #7
+ bne Header
+ lda #$21
+ sta PPUADDR
+ lda #0
+ sta PPUADDR
+ lda #$24
+ ldx #0
+ ldy #2
+BlankPage:sta PPUDATA
+ inx
+ bne BlankPage
+ dey
+ bne BlankPage
+ ldx #96
+BlankTail:sta PPUDATA
+ dex
+ bne BlankTail
+ ldy #0
+ ldx #0
+Row:lda CheatsSixQueue::AddrHi,y
+ sta PPUADDR
+ lda CheatsSixQueue::AddrLo,y
+ sta PPUADDR
+ lda #22
+ sta R0
+Copy:lda Text,x
+ sta PPUDATA
+ inx
+ dec R0
+ bne Copy
+ iny
+ cpy #6
+ bcc Row
+ lda #$22
+ sta PPUADDR
+ lda #$ea
+ sta PPUADDR
+ ldx #0
+BackCopy:lda Back,x
+ sta PPUDATA
+ inx
+ cpx #8
+ bcc BackCopy
+ plp
+ rts
+Back:.byte "B - BACK"
+Title:.byte "CHEATS "
+Text:
+ .byte "INVINCIBLE            "
+ .byte "START LEVEL           "
+ .byte "MID-AIR JUMPS         "
+ .byte "SCREEN WRAP           "
+ .byte "FREEZE TIMER          "
+ .byte "FULL POWER            "
+ .assert *-Text=132,error,"six22-cell cheat labels"
+.endproc
+
+.proc CheatsGameRoutinesGate
+ ; Only the cheat-enabled or source-injury path enters. All-off retains the
+ ; original farcall path, with one ORA admission instruction added resident.
+ php
+ pha
+ phx
+ phy
+ ldx #7
+Save:lda R0,x
+ pha
+ dex
+ bpl Save
+ jsr CheatsActive
+ bcc Restore
+ lda CheatInvincible
+ and #CheatTimer
+ beq :+
+ lda #2
+ sta GameTimerCtrlTimer
+:
+ lda GuestPowerupActive
+ ora GuestHurtKind
+ ora GuestHurtTicks
+ bne Restore
+ lda CheatInvincible
+ and #CheatWrap
+ beq :+
+ jsr CheatsWrapPlayer
+:
+ lda CheatInvincible
+ and #CheatAir
+ beq :+
+ jsr CheatsAirJump
+:
+ lda CheatInvincible
+ and #CheatPower
+ beq Restore
+ jsr CheatsFullPower
+Restore:
+ ldx #0
+Pop:pla
+ sta R0,x
+ inx
+ cpx #8
+ bcc Pop
+ ply
+ plx
+ pla
+ plp
+ lda GuestHurtKind
+ beq Native
+ farcall GuestInjuryGameRoutines,jmp
+Native:farcall GameRoutines,jmp
+.endproc
+.proc CheatsActive
+ lda OperMode
+ cmp #MODE_GAMEPLAY
+ bne No
+ lda OperMode_Task
+ cmp #3
+ bne No
+ lda GameEngineSubroutine
+ cmp #8
+ bne No
+ lda GamePauseStatus
+ and #1
+
+ bne No
+ sec
+ rts
+No:clc
+ rts
+.endproc
+.proc CheatsAirJump
+ lda JumpspringAnimCtrl
+ bne Done
+ lda SelectedCharacter
+ cmp #18
+ beq Done
+ lda SwimmingFlag
+ bne Done
+ lda Player_State
+ beq Done
+ cmp #3
+ bcs Done
+ lda SelectedCharacter
+ cmp #CHARACTER_TMNT
+ beq Turtle
+ lda SavedJoypadBits
+ and #A_Button
+ beq Done
+ lda PreviousA_B_Buttons
+ and #A_Button
+ bne Done
+Rearm:
+ ; Ground admission only; real hero wrappers compute jump impulse, native
+ ; fractional motion, animation and jump SFX. Do not synthesize a velocity.
+ lda #0
+ sta Player_State
+ lda SelectedCharacter
+ cmp #CHARACTER_SIMON
+ bne Done
+ lda Cv3Variant
+ beq Done
+ lda #0
+ sta Cv3JumpActive
+ sta Cv3JumpPhase
+Done:rts
+Turtle:
+ ; The real two-update TMNT producer queues a fresh A on the skipped tick.
+ ; Re-arm only at its consuming tick, otherwise BG collision erases the
+ ; fabricated grounded admission before the genuine initializer executes.
+ lda TnClock
+ and #1
+ beq Done
+ lda PreviousA_B_Buttons
+ eor #$ff
+ and SavedJoypadBits
+ ora TnPendingFresh
+ and #A_Button
+ beq Done
+ jmp Rearm
+.endproc
+
+.proc CheatsWrapPlayer
+ lda JumpspringAnimCtrl
+ jne Done
+ lda Player_State
+ cmp #3
+ jcs Done
+ lda SelectedCharacter
+ cmp #18
+ beq Ship
+ ; Largest retained dry step is TMNT native cap9 pixels. Check
+ ; before native motion:232 catches a falling body before guest pit241.
+ lda Player_Y_HighPos
+ cmp #1
+ bcc Top
+ bne Bottom
+ lda SelectedCharacter
+ cmp #CHARACTER_TMNT
+ bne CommonTop
+ lda Player_State
+ beq CommonTop
+ lda Player_Y_Position
+ cmp #41
+ bcc Top
+CommonTop:lda Player_Y_Position
+ cmp #32
+ bcc Top
+ cmp #232
+ jcc Done
+Bottom:lda #32
+ ldx #16
+ bne Search
+Top:lda #192
+ ldx #$f0
+Search:sta R2
+ stx R3
+ lda #11
+ sta R4
+Candidate:
+ jsr CheatsWrapClear
+ bcs Move
+ lda R2
+ clc
+ adc R3
+ sta R2
+ dec R4
+ bne Candidate
+ rts ; No free32x32 landing volume: retain native body, no hidden terrain edit.
+Move:lda R2
+ sta Player_Y_Position
+ lda #1
+ sta Player_Y_HighPos
+ ; Canonical world position is the native input for every platform adapter;
+ ; fractional velocity remains unchanged. Actual enemy/background runs next.
+ rts
+Ship:
+ ; Native Gradius/Parodius clamp before crossing the screen. Admit held
+ ; direction at their real clamp, update both real owner images before tick.
+ lda SavedJoypadBits
+ and #Down_Dir
+ beq ShipUp
+ lda VvObjY
+ cmp #192
+ bcc Done
+ lda #8
+ bne ShipMove
+ShipUp:lda SavedJoypadBits
+ and #Up_Dir
+ beq Done
+ lda VvObjY
+ cmp #17
+ bcs Done
+ lda #168
+ShipMove:clc
+ adc #24
+ sta R2
+ lda #16
+ ldx R2
+ cpx #100
+ bcc ShipSearch
+ lda #$f0
+ShipSearch:sta R3
+ lda #11
+ sta R4
+ShipCandidate:jsr CheatsWrapClear
+ bcs ShipClear
+ lda R2
+ clc
+ adc R3
+ sta R2
+ dec R4
+ bne ShipCandidate
+ rts
+ShipClear:lda R2
+ sec
+ sbc #24
+ sta VvObjY
+ sta PnY
+ lda #0
+ sta VvObjYF
+ sta PnYF
+ lda VvObjY
+ clc
+ adc #24
+ sta Player_Y_Position
+ lda #1
+ sta Player_Y_HighPos
+Done:rts
+.endproc
+.proc CheatsWrapClear
+ ; Six actual tile queries cover a conservative32x32 volume at sameworldX.
+ ; The real buffer pointer and current native MTileAttribute own solidity.
+ lda #0
+ sta R5
+Column:
+ ldx R5
+ lda Player_X_Position
+ clc
+ adc Deltas,x
+ sta R0
+ lda Player_PageLoc
+ adc #0
+ and #1
+ asl
+ asl
+ asl
+ asl
+ sta R1
+ lda R0
+ lsr
+ lsr
+ lsr
+ lsr
+ ora R1
+ jsr GetBlockBufferAddr
+ lda R2
+ sec
+ sbc #32
+ sta R0
+ tay
+ lda (R6),y
+ tay
+ lda MTileAttribute,y
+ and #MTILE_SOLID
+ bne Blocked
+ lda R0
+ clc
+ adc #16
+ tay
+ lda (R6),y
+ tay
+ lda MTileAttribute,y
+ and #MTILE_SOLID
+ bne Blocked
+ inc R5
+ lda R5
+ cmp #3
+ bcc Column
+ sec
+ rts
+Blocked:clc
+ rts
+Deltas:.byte 0,16,31
+.endproc
+
