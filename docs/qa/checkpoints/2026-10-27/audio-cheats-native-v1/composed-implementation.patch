+ jsr SoundTestReset
+ lda #3
+ sta CrossoverOptionsFocus
+ sta CrossoverMenuState
+ lda #1
+ sta DisableScreenFlag
+ rts
+Navigate:
+ lda CrossoverMenuPressed
+ and #Up_Dir|Down_Dir
+ beq Category
+ ldx SoundTestHero
+ and #Up_Dir
+ beq NextHero
+ dex
+ bpl HeroReady
+ ldx #SoundTestHeroCount-1
+ bne HeroReady
+NextHero:
+ inx
+ cpx #SoundTestHeroCount
+ bcc HeroReady
+ ldx #0
+HeroReady:
+ stx SoundTestHero
+ lda #0
+ sta SoundTestIndex
+ jmp Stop
+Category:
+ lda CrossoverMenuPressed
+ and #Select_Button
+ beq Track
+ lda SoundTestKind
+ eor #1
+ sta SoundTestKind
+ lda #0
+ sta SoundTestIndex
+ jmp Stop
+Track:
+ lda CrossoverMenuPressed
+ and #Left_Dir|Right_Dir
+ beq Playback
+ jsr Count
+ stx R2
+ ldx SoundTestIndex
+ lda CrossoverMenuPressed
+ and #Left_Dir
+ beq NextTrack
+ dex
+ bpl TrackReady
+ ldx R2
+ dex
+ bpl TrackReady
+NextTrack:
+ inx
+ cpx R2
+ bcc TrackReady
+ ldx #0
+TrackReady:
+ stx SoundTestIndex
+ jmp Stop
+Playback:
+ lda CrossoverMenuPressed
+ and #Start_Button
+ jne Stop
+ lda CrossoverMenuPressed
+ and #A_Button
+ jeq Done
+ lda #0
+ sta SoundTestPlaying
+ sta SoundTestCommand
+ jsr SoundTestRestoreVariant
+ jsr SoundTestReset
+ ldx SoundTestHero
+ lda SoundTestHeroIds,x
+ sta SoundTestReserved
+ lda SoundTestVariantHi,x
+ beq VariantReady
+ sta SoundTestSavedVariantHi
+ sta R1
+ lda SoundTestVariantLo,x
+ sta SoundTestSavedVariantLo
+ sta R0
+ ldy #0
+ lda (R0),y
+ sta SoundTestSavedVariantValue
+ lda SoundTestVariantValue,x
+ sta (R0),y
+ lda #1
+ sta SoundTestVariantActive
+VariantReady:
+ lda SoundTestKind
+ beq MusicCue
+ cmp #1
+ bne MusicCue
+ lda SoundTestReserved
+ cmp #CHARACTER_PIT
+ bcc EffectCue
+ cmp #CHARACTER_BASS
+ beq EffectCue
+ cmp #CHARACTER_RYU
+ beq EffectCue
+ cmp #CHARACTER_SOPHIA
+ beq EffectCue
+ lda #CHARACTER_PIT
+ sta SoundTestReserved
+EffectCue:
+ lda SelectedCharacter
+ pha
+ lda SoundTestReserved
+ sta SelectedCharacter
+ farcall GuestAudioBegin
+ pla
+ sta SelectedCharacter
+ jsr SoundTestEffectPointer
+ ldy #0
+ lda (R0),y
+ sta SoundTestCueKind
+ iny
+ lda (R0),y
+ sta SoundTestCueValue
+ jsr SoundTestCue
+ jmp Play
+MusicCue:
