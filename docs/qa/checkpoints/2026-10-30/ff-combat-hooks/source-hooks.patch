+
+.export FwNativeEnemyInit
+.import FwHostNewEnemy
+.import MmEnemyHealthLo,MmEnemyHealthHi,MmEnemyFlash,RgEnemyStun,LsrFrozenPose
+.import AvFrozen,AvFrozenHi,GuestBodyPrev,GuestBodyNow
+FwNativeEnemyInit:
+  lda #0
+  sta MmEnemyHealthLo,x
+  sta MmEnemyHealthHi,x
+  sta MmEnemyFlash,x
+  sta RgEnemyStun,x
+  sta LsrFrozenPose,x
+  sta AvFrozen,x
+  sta AvFrozenHi,x
+  ; A reused native slot is a new source object, even if its ID is unchanged.
+  lda FwEnemyClearBits,x
+  and GuestBodyPrev
+  sta GuestBodyPrev
+  lda FwEnemyClearBits,x
+  and GuestBodyNow
+  sta GuestBodyNow
+ php
+ jsr FwCheck
+ bcc NoFF
+ plp
+ jmp FwHostNewEnemy
+NoFF:plp
+ rts
+FwEnemyClearBits:.byte $fe,$fd,$fb,$f7,$ef,$df
