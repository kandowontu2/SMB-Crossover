--- a/src/inventory.s
+++ b/src/inventory.s
@@ -735,7 +735,11 @@
   beq :+
     ldx SelectedCharacter
     lda #0
+ .if ::ENABLE_MMC5_EXPANDED
+    jsr InventorySelectionCommit
+ .else
     sta InvSelected,x
+ .endif
     jmp Changed
   :
   lda InvFresh
@@ -745,7 +749,13 @@
   jsr InventoryCycle
 Changed:
   inc InvDirty
+ .if ::ENABLE_MMC5_EXPANDED
+  nop                          ; Commit owns cleanup, preserving the old span.
+  nop
+  nop
+ .else
   jsr InventoryClearActive
+ .endif
   jmp Hud
 Hud:
   jsr InventoryHud
@@ -828,8 +838,13 @@
 Chosen:
   ldx SelectedCharacter
   lda InvCandidate
+ .if ::ENABLE_MMC5_EXPANDED
+  jmp InventorySelectionCommit
