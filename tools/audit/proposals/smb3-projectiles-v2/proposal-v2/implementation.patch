@@ -0,0 +1,30 @@
+; Private bounded proposal: source hammers pierce fire-only armor.
+; Bowser receives the host's existing native boss damage rather than StnE.
+.pushseg
+.segment "M3_LOGIC"
+.proc M3AuditProjectileAdmission
+ lda Enemy_ID,y
+ cmp #Bowser
+ beq Allowed
+ cmp #BuzzyBeetle
+ bne Ordinary
+ ldx M3SavedSlot
+ lda M3ShotKind,x
+ cmp #2
+ bne BeetleFire
+ lda #0 ; Only the following temporary ID filters see this value.
+Allowed:clc
+ rts
+BeetleFire:lda #BuzzyBeetle
+Ordinary:cmp #$15
+ rts
+.endproc
+.proc M3AuditProjectileDamage
+ lda Enemy_ID,x
+ cmp #Bowser
+ beq Boss
+ jmp M3DefeatEnemy
+Boss:stx R1
+ jmp HandleEnemyFBallCol
+.endproc
+.popseg
