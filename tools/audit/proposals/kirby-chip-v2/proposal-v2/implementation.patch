--- a/src/entrypoint.s
+++ b/src/entrypoint.s
@@ -429,3 +429,38 @@
 .include "hot_render_gate.s"
 
 .endif
+
+; Contact objects on another vertical page cannot overlap a visible shot.
+.if ::ENABLE_MMC5_EXPANDED
+.pushseg
+.segment "KIRBY_ABILITIES"
+.proc KbContactSlotAdmission
+  cpx #6
+  bcs Inactive
+  lda Enemy_Y_HighPos,x
+  cmp #1
+  bne Inactive
+  clc                         ; Original valid-slot CPX carry remains clear.
+  rts
+Inactive:
+  sec
+  rts
+.endproc
+.popseg
+.pushseg
+.segment "CD_LOGIC"
+.proc CdContactSlotAdmission
+  lda Enemy_Y_HighPos,x
+  cmp #1
+  bne Inactive
+  lda Enemy_Flag,x
+  beq Inactive
+  bmi Inactive
+  sec
+  rts
+Inactive:
+  clc
+  rts
+.endproc
+.popseg
+.endif
